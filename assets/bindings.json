{
  "schemaVersion": 1,
  "note": "capture 为插槽号，keys 为状态树路径分段。listBinding 对应模板中带 data-mvu-list 的容器，其 <template> 内的插槽相对成员取值。R25：**在场卡整体并入档案卡**，面板只保留「规则列表 + 档案卡」，不再有 /在场卡 绑定；原在场卡独有的 位置/立绘 两个字段已移除。档案卡 23 字段：$401-$419 为原有插槽（其中 $407 由「外貌」改为「人物介绍」，保留「外貌」等别名），$421 当前内心 / $423 发情度（R32 由「欲情」改名，变量路径同步）/ $424 高潮度 / $425 状态 为原在场卡字段迁入，$426 射精度 为 R32 新增（交合中男性对象的射精累积进度）。",

  "global": [
    { "capture": 1, "keys": ["$meta", "幕"],                 "fallback": "未分幕" },
    { "capture": 4, "keys": ["$meta", "说明"] },
    { "capture": 5, "keys": ["计数", "规则"] },
    { "capture": 6, "keys": ["计数", "在场"] },
    { "capture": 7, "keys": ["计数", "档案"] },
    { "capture": 8, "keys": ["计数", "待生效"] }
  ],

  "listBinding": {
    "/规则列表/条目": [
      { "capture": 201, "keys": ["文本"] },
      { "capture": 202, "keys": ["状态"], "fallback": "生效" },
      { "capture": 204, "keys": ["状态"], "cast": "toggleLabel" }
    ],
    "/规则列表/待生效": [
      { "capture": 203, "keys": [] }
    ],
    "/档案卡": [
      { "capture": 401, "keys": ["名字"] },
      { "capture": 402, "keys": ["年龄"], "fallback": "—" },
      { "capture": 403, "keys": ["胸围"], "fallback": "—" },
      { "capture": 404, "keys": ["罩杯"], "fallback": "—" },
      { "capture": 405, "keys": ["腰围"], "fallback": "—" },
      { "capture": 406, "keys": ["臀围"], "fallback": "—" },
      { "capture": 407, "keys": ["人物介绍"], "fallback": "—" },
      { "capture": 408, "keys": ["当前着装"], "fallback": "—" },
      { "capture": 409, "keys": ["与你关系"], "fallback": "—" },
      { "capture": 410, "keys": ["最近交互"], "fallback": "无" },
      { "capture": 413, "keys": ["性癖"], "fallback": "—" },
      { "capture": 414, "keys": ["胸部"], "fallback": "—" },
      { "capture": 415, "keys": ["臀部"], "fallback": "—" },
      { "capture": 416, "keys": ["小穴"], "fallback": "—" },
      { "capture": 417, "keys": ["菊穴"], "fallback": "—" },
      { "capture": 418, "keys": ["好感度"], "fallback": "0" },
      { "capture": 419, "keys": ["性经验"], "fallback": "" },
      { "capture": 421, "keys": ["当前内心"], "fallback": "" },
      { "capture": 423, "keys": ["发情度"], "fallback": "0" },
      { "capture": 424, "keys": ["高潮度"], "fallback": "0" },
      { "capture": 426, "keys": ["射精度"], "fallback": "0" },
      { "capture": 425, "keys": ["状态"], "cast": "joinList" },
      { "capture": 411, "keys": ["在场"], "cast": "dotClass" },
      { "capture": 412, "keys": ["在场"], "cast": "presenceText" }
    ]
  },

  "casts": {
    "dotClass": { "true": "mvu-dot-on", "false": "mvu-dot-off" },
    "presenceText": { "true": "在场", "false": "离场" },
    "toggleLabel": { "生效": "停用", "停用": "启用", "待删除": "恢复" }
  },

  "synonyms": {
    "名字": ["姓名", "名称", "角色名", "name"],
    "当前着装": ["着装", "穿着", "衣着", "服装", "衣物"],
    "当前内心": ["内心", "内心活动", "心理活动", "内心独白", "心声"],
    "欲情": ["性欲", "欲求", "情欲", "兴奋度", "性兴奋"],
    "高潮度": ["高潮", "高潮进度", "绝顶", "累计高潮", "climax"],
    "好感度": ["好感", "亲密度", "羁绊", "affinity"],
    "性经验": ["性经历", "性经历标签", "性历", "经验", "繁育状态", "妊娠状态", "生育情况", "受孕状态", "贞操状态", "怀孕状态", "孕产状态"],
    "年龄": ["岁数", "年纪", "age"],
    "胸围": ["bust", "B"],
    "罩杯": ["cup", "罩杯尺寸", "C"],
    "腰围": ["waist", "W"],
    "臀围": ["hip", "H"],
    "人物介绍": ["外貌", "外观", "长相", "外貌描写", "样貌", "简介", "人物简介", "人物描述"],
    "与你关系": ["关系", "与你的关系", "和你的关系"],
    "最近交互": ["最近互动", "最近一次交互", "最新交互", "最近事件"],
    "性癖": ["癖好", "萌点", "性癖好", "fetish"],
    "胸部": ["胸", "乳房", "胸部状态"],
    "臀部": ["臀", "屁股", "臀部状态"],
    "小穴": ["阴道", "穴", "私处"],
    "菊穴": ["后穴", "肛门", "菊花"],
    "文本": ["规则", "内容", "规则文本", "rule"],
    "状态": ["规则状态", "state", "本轮状态", "境况"],
    "在场": ["是否在场", "present"]
  }
}
